# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 6.0.2 Project Minimal Configuration
#
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096
CONFIG_SPIRAM=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_FATFS_LFN_HEAP=y

# File names on the card are UTF-8. The stock setting (code page 437) mangles
# anything outside basic ASCII.
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Performance: optimise for speed, run at full clock speed.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# This board's chip is revision 3.1. Declaring revision 3 as the minimum drops
# the PSRAM cache workaround needed only by older chips, which slows every
# PSRAM access and uses about 15KB of IRAM.
CONFIG_ESP32_REV_MIN_3=y

# The application is larger than the 1 MB the default partition table gives
# it. This table has the same data partitions at the same places (nvs, where
# the settings are saved, is 24 KB at 0x9000) and a 1.5 MB application.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# The I2S interrupt must run while flash is being written. Saving a setting
# writes flash, and now and then erases a 4 KB page, which takes 29 ms; code
# in flash, interrupts included, is held up for that long on both cores. The
# I2S interrupt hands each buffer it has sent back to be refilled, once every
# 11 ms at 44.1 kHz. Held up for 29 ms it missed a buffer, and the DMA played
# that buffer's old contents a second time (measured: one late interrupt per
# page erase; none with this option). It adds about 700 bytes to the firmware.
CONFIG_I2S_ISR_IRAM_SAFE=y

# Lets a task's stack be in PSRAM when the task is created with one there
# (xTaskCreatePinnedToCoreWithCaps). Only the playlist task does so: it never
# writes flash, so its stack is never touched while the flash cache is off,
# and this chip revision (3) has no PSRAM cache bug for ROM code to trip on.
# It saves 6 KB of internal RAM. Other tasks still get internal stacks.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
